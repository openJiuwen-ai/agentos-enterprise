# Application inputs retain their original meaning. Empty listener values use
# the installed .env, then agent-runtime settings. ADX wiring is package-owned.
PYTHON_VERSION="3.11"
BIND_IP=""
JIUWENSWARM_INSTANCE_NAME=""
# Empty preserves the installed scope; fresh default: per_chat_bot_user.
GATEWAY_SESSION_MAP_SCOPE=""
EXTENSION_DIRS=""
MASTER_NODE_IP=""
ETCD_ENDPOINTS=""
GATEWAY_HOST=""
GATEWAY_PORT=""
WEB_HOST=""
WEB_PORT=""
WEB_STATIC_HOST=""
WEB_STATIC_PORT=""
WEB_ENABLED=""
# Historical static-Web listener alias; empty preserves the installed value.
FRONTEND_HOST=""
FRONTEND_PORT=""

# Optional tool sandbox overrides. Empty values keep the configured values.
# Defaults: 2000 millicores, 4096 MiB, and 600 seconds of inactivity.
TOOL_SANDBOX_CPU=""
TOOL_SANDBOX_MEMORY=""
TOOL_SANDBOX_IDLE_TIMEOUT=""

# Optional business model settings.
MODEL_PROVIDER=""
MODEL_NAME=""
API_BASE=""
API_KEY=""
EMBED_API_KEY=""
EMBED_API_BASE=""
EMBED_MODEL=""
