# Application inputs retain their original meaning. Empty listener values use
# the installed .env, then deployment defaults.
PYTHON_VERSION="3.11"
BIND_IP=""
JIUWENSWARM_INSTANCE_NAME=""
# Empty preserves the installed scope; fresh default: per_chat_bot_user.
GATEWAY_SESSION_MAP_SCOPE=""
EXTENSION_DIRS=""
MASTER_NODE_IP=""
ETCD_ENDPOINTS=""
GATEWAY_HOST=""
GATEWAY_PORT=""
WEB_HOST=""
WEB_PORT=""
WEB_STATIC_HOST=""
WEB_STATIC_PORT=""
WEB_ENABLED=""
# Historical static-Web listener alias; empty preserves the installed value.
FRONTEND_HOST=""
FRONTEND_PORT=""

# Tool sandbox deployment defaults. Nonempty values override the installed .env.
# Defaults: 2000 millicores, 4096 MiB, and 600 seconds of inactivity.
TOOL_SANDBOX_ENABLE="true"
# runsc (historical docker is accepted) or conch.
TOOL_SANDBOX_EXECUTOR="runsc"
# Docker image for runsc; native image/template reference for Conch.
TOOL_SANDBOX_IMAGE="swr.cn-southwest-2.myhuaweicloud.com/yuanrong-dev/tool-sandbox:latest"
TOOL_SANDBOX_CPU="2000"
TOOL_SANDBOX_MEMORY="4096"
TOOL_SANDBOX_IDLE_TIMEOUT="600"
TOOL_SANDBOX_USER="agentos"
TOOL_SANDBOX_GROUP="agentos"

# Builtin AgentServer resource startup values; management-plane overrides retain
# their existing behavior. CPU: millicores; memory: MiB.
AGENTOS_BUILTIN_AGENT_CPU="2000"
AGENTOS_BUILTIN_AGENT_MEMORY="4096"

# Authentication URL is derived from the cluster when blank; timeout is seconds.
AGENTOS_AUTH_SERVICE_URL=""
AGENTOS_AUTH_TIMEOUT="10"
# Registry listen and client ports use the deployment A2X_REGISTRY_PORT input.

# Independent managed runsc network profiles: N0 closed, N1 explicit origins,
# N2 public Internet. Cluster addresses remain blocked by default.
AGENTOS_AGENT_NETWORK_PROFILE="N2"
TOOL_SANDBOX_NETWORK_PROFILE="N2"
# Private model origins for AgentServer and extra tool targets, as JSON URL lists.
# Model addresses are discovered from each workspace.
AGENTOS_ALLOWED_INTERNAL_ORIGINS='[]'
TOOL_SANDBOX_ALLOWED_ORIGINS='[]'

# Optional business model settings.
MODEL_PROVIDER=""
MODEL_NAME=""
API_BASE=""
API_KEY=""
EMBED_API_KEY=""
EMBED_API_BASE=""
EMBED_MODEL=""
